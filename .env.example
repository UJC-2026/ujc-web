# Supabase — ambil dari Project Settings > API di dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Jangan pernah diekspos ke client. Hanya dipakai di server (mis. baca bank soal CBT).
SUPABASE_SERVICE_ROLE_KEY=

# URL publik situs, dipakai untuk redirect auth & metadata Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — enables /assistant. Without it the page renders a "belum
# diaktifkan" notice instead of a form that fails on submit.
# Costs money per reply; the daily per-member ceiling lives in migration 0025.
ANTHROPIC_API_KEY=
